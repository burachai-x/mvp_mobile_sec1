# === Secrets — ห้าม commit เด็ดขาด (CLAUDE.md §3, §6) ===
.env
.env.*
!.env.example
secrets/
*.jks
*.keystore
*.p8
*.p12
*.pfx
*.key
*.pem
!*.pub.pem
# root CA ของ Google สำหรับตรวจ Android Key Attestation — เป็นค่าสาธารณะ
# ไม่มี private key · ถ้าไม่ commit ผู้ที่ clone ไปจะตรวจ attestation chain ไม่ได้เลย
# ซึ่งทำให้ชั้น L2.5 ที่ทั้งระบบพึ่งพาใช้งานไม่ได้ (architecture.md §4.2)
!apps/api/resources/attestation/*.pem

# === Dependencies ===
/apps/api/vendor/
/apps/api/node_modules/
node_modules/

# === Laravel runtime ===
/apps/api/storage/*.key
/apps/api/storage/framework/cache/*
/apps/api/storage/framework/sessions/*
/apps/api/storage/framework/testing/*
/apps/api/storage/framework/views/*
/apps/api/storage/logs/*
/apps/api/bootstrap/cache/*
/apps/api/public/build/
/apps/api/public/hot
/apps/api/public/storage
!.gitkeep

# === Docker volume data (bind-mounted ตอน dev) ===
/.data/

# === Flutter ===
/apps/mobile/build/
/apps/mobile/.dart_tool/
/apps/mobile/.flutter-plugins
/apps/mobile/.flutter-plugins-dependencies
/apps/mobile/android/key.properties
/apps/mobile/android/local.properties
/apps/mobile/ios/Pods/
*.apk
*.aab

# === Database dumps ===
*.sql
*.sqlite
*.sqlite3
*.dump

# === Editor / OS ===
.idea/
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db
*.swp
*~

# cert ของ dev สร้างใหม่ได้ด้วย scripts/dev-tls.sh และมี private key อยู่ด้วย
# สำเนา CA (ค่าสาธารณะ) ที่ debug build ต้องใช้ ถูก commit ไว้ที่
# apps/mobile/android/app/src/debug/res/raw/dev_ca.crt
/docker/nginx/dev-tls/

# === index cache ของเครื่องมือค้นโค้ด (มี transcript ของ session ติดอยู่ด้วย) ===
/graft/
/.ignore
