# คัดลอกเป็น .env แล้วเติมค่า — หรือใช้ `make init` ซึ่งสุ่มให้อัตโนมัติ
#
# 🔴 ไฟล์นี้เป็น "ตัวอย่าง" เท่านั้น ห้ามใส่ค่าจริงลงไปแล้ว commit
#    บน production ห้ามใช้ env — ต้องใช้ Docker secrets (compose.prod.yaml)
#    เพราะ env อ่านได้จาก `docker inspect` และติดไปกับ crash dump

# ── application ──────────────────────────────────────────────
APP_VERSION=0.1.0
APP_KEY=CHANGE_ME
MIN_SUPPORTED_APP_VERSION=1

# port ฝั่ง host (dev)
HTTP_PORT=80             # redirect ไป https อย่างเดียว
HTTPS_PORT=443
# IP ของแล็ปท็อปในวง LAN — dnsmasq ตอบ *.driver.test เป็นค่านี้ (เปลี่ยนตอนย้ายที่)
HOST_LAN_IP=192.168.1.10           # api / staff / dl แยกด้วยชื่อโฮสต์ (SNI)

# ตั้งเมื่อเข้าจากเครื่องอื่นในวง LAN — Filament สร้างลิงก์และ asset จาก APP_URL
# ถ้าปล่อยเป็น localhost แล้วเปิดจากเครื่องอื่น หน้าจะโหลดแต่ CSS/JS พัง

# API_URL=https://api.driver.test
# ชื่อโฮสต์ dev ใช้ nip.io — ชื่อมี IP อยู่ในตัว resolve ผ่าน DNS สาธารณะ
#   https://api.<ip>.nip.io  https://staff.<ip>.nip.io  https://dl.<ip>.nip.io
MAILPIT_PORT=8025

# ── database ─────────────────────────────────────────────────
POSTGRES_DB=mvp
POSTGRES_USER=mvp
POSTGRES_PASSWORD=CHANGE_ME

# ── ความปลอดภัย ──────────────────────────────────────────────
# HMAC pepper ของ device_uuid
# ⚠️ ห้ามเปลี่ยนหลังขึ้น production — hash เดิมทั้งหมดจะใช้ไม่ได้
DEVICE_UUID_PEPPER=CHANGE_ME

# กุญแจห่อ DEK ของเอกสาร (ADR 0005)
# ⚠️ หายแล้วเอกสารทุกไฟล์กู้ไม่ได้ตลอดกาล
# ⚠️ บน production ห้ามเก็บไว้ที่เดียวกับ backup ของ PostgreSQL
DOCUMENT_KEK=CHANGE_ME
DOCUMENT_KEK_VERSION=1

# กุญแจเข้ารหัสเลขบัตรประชาชน
NATIONAL_ID_ENCRYPTION_KEY=CHANGE_ME

# ES256 keypair สำหรับเซ็น/ตรวจ activation token (ห้ามใช้ HS256)
# `make init` สร้างคู่ของ dev ให้อัตโนมัติ · สร้างใหม่ด้วย `make activation-keys`
ACTIVATION_JWT_PRIVATE_KEY=
ACTIVATION_JWT_PUBLIC_KEY=

# SHA-256 fingerprint ของ signing cert — คั่นด้วย comma รองรับหลายค่า
# ต้องรับหลายค่าเพื่อให้หมุน key ได้โดยผู้ใช้เดิมไม่โดน 403 พร้อมกัน (§6.8)
APP_SIGNATURE_SHA256_ALLOWLIST=

# Android Key Attestation — MVP รัน monitor mode ก่อน (§4.2)
# true = ปฏิเสธเครื่องที่ verifiedBootState != Verified
KEY_ATTESTATION_ENFORCE=false

# ── Garage (object storage) ──────────────────────────────────
GARAGE_ACCESS_KEY=CHANGE_ME
GARAGE_SECRET_KEY=CHANGE_ME

# ── ที่ไม่ได้อยู่ในไฟล์นี้โดยเจตนา ────────────────────────────
# MANIFEST_SIGNING_KEY — ต้องอยู่นอกเซิร์ฟเวอร์ (CI secret หรือออฟไลน์)
#   ลงนาม manifest แบบออฟไลน์แล้วอัปโหลดเฉพาะไฟล์ที่ลงนามเสร็จ (ADR 0006)
# release.jks + keystore password — CI secret เท่านั้น (PRD §2.1)
